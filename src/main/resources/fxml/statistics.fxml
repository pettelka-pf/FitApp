<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<!-- Christian: Layout der Seite "StepCounter Statistik". Controller: StatisticsController. -->
<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitapp.controller.StatisticsController">

    <!-- Christian: Hintergrundbild wie beim Step Counter. -->
    <ImageView fx:id="backgroundImage"
               preserveRatio="true"
               smooth="true"
               opacity="0.9"
               pickOnBounds="false">
        <image>
            <Image url="@/images/stepcounter-image.png" />
        </image>
    </ImageView>

    <!-- Christian: weisse Karte mit dem Diagramm. -->
    <VBox spacing="10"
          alignment="TOP_CENTER"
          maxWidth="780"
          maxHeight="560"
          style="-fx-background-color: rgba(255,255,255,0.9);
                 -fx-background-radius: 12;
                 -fx-padding: 18;">

        <Label text="Steps and Calories Statistic"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <!-- Christian: angemeldeter Benutzer. -->
        <Label fx:id="userNameLabel" style="-fx-font-weight: bold;" />

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Monat" />
            <ComboBox fx:id="monatBox" onAction="#handleMonatWechsel" />
        </HBox>

        <Button fx:id="statistikWechselButton"
                text="Kalorien anzeigen"
                onAction="#handleStatistikWechsel" />

        <BarChart fx:id="chart"
                  legendVisible="false"
                  VBox.vgrow="ALWAYS">

            <xAxis>
                <CategoryAxis fx:id="xAxis"
                              label="Tag im Monat" />
            </xAxis>

            <yAxis>
                <NumberAxis fx:id="yAxis"
                            label="Erreichte Schritte" />
            </yAxis>
        </BarChart>


        <Button text="Back to Main Menu"
                maxWidth="Infinity"
                onAction="#handleBackToMenu" />
    </VBox>

</StackPane>
