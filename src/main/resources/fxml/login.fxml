<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitapp.controller.LoginController">

    <!-- Background image -->
    <ImageView fx:id="backgroundImage"
               preserveRatio="true"
               smooth="true"
               opacity="0.9"
               pickOnBounds="false">
        <image>
            <Image url="@/images/health-background.png" />
        </image>
    </ImageView>

    <!-- LOGIN PANEL -->
    <VBox fx:id="loginPanel"
          spacing="15"
          alignment="CENTER"
          maxWidth="300"
          style="-fx-background-color: rgba(255,255,255,0.85);
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Welcome Back"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField"
                   promptText="Username"/>

        <PasswordField fx:id="passwordField"
                       promptText="Password"/>

        <Button text="Login"
                maxWidth="Infinity"
                defaultButton="true"
                style="-fx-font-size: 14px;"
                onAction="#handleLogin"/>

        <Button text="Noch kein Account? Registrieren →"
                onAction="#showRegister"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #aaaaaa;
                       -fx-font-size: 12;
                       -fx-cursor: hand;"/>

        <Label fx:id="errorLabel"
               text="Login Failed"
               textFill="RED"
               visible="false"/>
    </VBox>

    <!-- REGISTER PANEL -->
    <VBox fx:id="registerPanel"
          spacing="15"
          alignment="CENTER"
          maxWidth="300"
          visible="false"
          style="-fx-background-color: rgba(255,255,255,0.85);
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Create Account"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

        <TextField fx:id="regUsernameField"
                   promptText="Username"/>

        <PasswordField fx:id="regPasswordField"
                       promptText="Password"/>

        <PasswordField fx:id="regConfirmField"
                       promptText="Confirm Password"/>

        <Button text="Registrieren"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleRegister"/>

        <Button text="← Zurück zum Login"
                onAction="#showLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #aaaaaa;
                       -fx-font-size: 12;
                       -fx-cursor: hand;"/>

        <Label fx:id="regErrorLabel"
               textFill="RED"
               visible="false"/>
    </VBox>

</StackPane>
