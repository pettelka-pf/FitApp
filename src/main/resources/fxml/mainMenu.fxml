<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>


<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fitapp.controller.MainMenuController">

    <!-- Background image -->
    <ImageView fx:id="backgroundImage"
               preserveRatio="true"
               smooth="true"
               opacity="0.9"
               pickOnBounds="false">
        <image>
            <Image url="@/images/menu.jpg" />
        </image>
    </ImageView>

    <!-- Menu card -->
    <VBox spacing="15"
          alignment="CENTER"
          maxWidth="320"
          style="-fx-background-color: rgba(255,255,255,0.85);
                 -fx-background-radius: 12;
                 -fx-padding: 25;">

        <Label text="Main Menu"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <Button text="Check Caloric Intake"
                fx:id="caloriesButton"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleCheckCalories" />

        <Button text="Step Counter"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleStepCounter" />

        <!-- Christian: Button zur StepCounter-Statistik (vorher "View Statistics", ohne Funktion). -->
        <Button text="Steps and Calories Statistic"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleViewStatistics" />

        <Button text="Add Exercise"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleAddExercise" />

        <Button text="Make Plan"
                maxWidth="Infinity"
                style="-fx-font-size: 14px;"
                onAction="#handleMakePlan" />

        <Button text="↪ Logout"
                onAction="#handleLogout"
                style="
            -fx-background-color: #dbeafe;
            -fx-text-fill: #1e3a5f;
            -fx-border-color: #93c5fd;
            -fx-border-width: 1;
            -fx-border-radius: 8;
            -fx-background-radius: 8;
            -fx-padding: 8 18;
            -fx-font-size: 13px;
            -fx-font-weight: bold;
        ">

            <VBox.margin>
                <Insets top="40"/>
            </VBox.margin>

        </Button>






    </VBox>

</StackPane>
