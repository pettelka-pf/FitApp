<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.fitapp.controller.PlanController">

    <!-- ========================= -->
    <!-- BACKGROUND                 -->
    <!-- ========================= -->

    <ImageView fx:id="backgroundImage"
               preserveRatio="true"
               smooth="true"
               opacity="0.9"
               pickOnBounds="false">
        <image>
            <Image url="@/images/trainingsplan_gross.png"/>
        </image>
    </ImageView>


    <!-- ========================= -->
    <!-- MAIN CONTENT               -->
    <!-- ========================= -->

    <HBox spacing="20"
          alignment="CENTER"
          style="-fx-padding: 25;">


        <!-- ================================================= -->
        <!-- LEFT SIDE - PLAN CREATION                         -->
        <!-- ================================================= -->

        <VBox spacing="12"
              alignment="CENTER"
              prefWidth="320"
              maxWidth="320"
              style="-fx-background-color: rgba(255,255,255,0.90);
                     -fx-background-radius: 12;
                     -fx-padding: 25;">

            <Label text="Create Training Plan"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>


            <!-- ========================= -->
            <!-- PLAN                       -->
            <!-- ========================= -->

            <TextField fx:id="planNameField"
                       promptText="Plan name"
                       maxWidth="Infinity"/>

            <DatePicker fx:id="startDatePicker"
                        promptText="Start date"
                        maxWidth="Infinity"/>

            <DatePicker fx:id="endDatePicker"
                        promptText="End date"
                        maxWidth="Infinity"/>

            <Button text="Create Plan"
                    onAction="#handleCreatePlan"
                    maxWidth="200"/>


            <Separator/>


            <!-- ========================= -->
            <!-- ADD DAY                    -->
            <!-- ========================= -->

            <Label text="Add Day"
                   style="-fx-font-weight: bold;"/>

            <ComboBox fx:id="dayField"
                      promptText="Select Day"
                      maxWidth="Infinity"/>

            <Button text="Add Day"
                    onAction="#handleAddDay"
                    maxWidth="200"/>


            <Separator/>


            <!-- ========================= -->
            <!-- ADD EXERCISE               -->
            <!-- ========================= -->

            <Label text="Add Exercise"
                   style="-fx-font-weight: bold;"/>


            <ComboBox fx:id="daySelector"
                      promptText="Select Day"
                      maxWidth="Infinity"/>


            <ComboBox fx:id="exerciseTypeBox"
                      promptText="Exercise Type"
                      onAction="#handleTypeSelect"
                      maxWidth="Infinity"/>


            <ComboBox fx:id="exerciseBox"
                      promptText="Exercise"
                      maxWidth="Infinity"/>


            <TextField fx:id="durationField"
                       promptText="Duration (min)"
                       maxWidth="Infinity"/>


            <TextField fx:id="setsField"
                       promptText="Sets (optional)"
                       maxWidth="Infinity"/>


            <TextField fx:id="repsField"
                       promptText="Reps (optional)"
                       maxWidth="Infinity"/>


            <Button text="Add Exercise to Day"
                    onAction="#handleAddExercise"
                    maxWidth="250"/>


            <Separator/>


            <!-- ========================= -->
            <!-- BACK                       -->
            <!-- ========================= -->

            <Button text="Back to Menu"
                    onAction="#handleBackToMenu"/>

        </VBox>


        <!-- ================================================= -->
        <!-- RIGHT SIDE - PLAN OVERVIEW                        -->
        <!-- ================================================= -->

        <VBox spacing="10"
              prefWidth="420"
              maxWidth="420"
              maxHeight="700"
              style="-fx-background-color: rgba(255,255,255,0.90);
                     -fx-background-radius: 12;
                     -fx-padding: 20;">

            <Label text="Training Plan Overview"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;"/>


            <!-- ========================= -->
            <!-- PLAN INFORMATION            -->
            <!-- ========================= -->

            <VBox spacing="5">

                <Label fx:id="overviewPlanName"
                       text="No plan created"
                       style="-fx-font-size: 16px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="overviewDates"
                       text="Start: - | End: -"/>

            </VBox>


            <Separator/>


            <!-- ========================= -->
            <!-- PLAN CONTENT                -->
            <!-- ========================= -->

            <ScrollPane fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;">

                <VBox fx:id="overviewContainer"
                      spacing="12"
                      style="-fx-padding: 5;"/>

            </ScrollPane>


            <Separator/>


            <!-- ========================= -->
            <!-- TOTALS                      -->
            <!-- ========================= -->

            <VBox spacing="4">

                <Label fx:id="overviewDuration"
                       text="Total duration: 0 min"/>

                <Label fx:id="overviewCalories"
                       text="Total calories: 0"/>

            </VBox>

            <!-- ========================= -->
            <!-- PLAN SWITCH BUTTON         -->
            <!-- ========================= -->

            <Label text="Choose your plan:"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>

            <ComboBox fx:id="planSelector"
                      promptText="no plan available"
                      maxWidth="Infinity"
                      onAction="#handlePlanSelection"/>

            <Button text="Delete selected plan"
                    onAction="#handleDeletePlan"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e74c3c;
               -fx-text-fill: white;
               -fx-font-weight: bold;"/>

        </VBox>

    </HBox>

</StackPane>
